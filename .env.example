# Copy to .env (never commit .env). In CI/CD these come from GitHub Actions secrets.
APP_ENV=production
APP_VERSION=dev
APP_MESSAGE=Hello from the capstone service
ENABLE_DEMO_ENDPOINTS=false

# Image to run (set automatically by the deploy workflow)
APP_IMAGE=cloud-capstone-app:local

# Public URL of the deployed app, used for the external uptime probe
PUBLIC_URL=http://203.0.113.10

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-please

# Optional: Slack (or Discord with the /slack suffix) incoming webhook for alerts
SLACK_WEBHOOK_URL=
